// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // REQUIRED for pgvector
}

datasource db {
  provider = "postgresql"
  extensions = [vector] // REQUIRED for pgvector
}

model User {
  id                String   @id @default(uuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  role              GlobalRole @default(USER)

  email             String   @unique
  username          String   @unique
  password          String
  avatar            String?
  bio               String?
  lastSeen          DateTime @default(now())
  refreshToken      String?
  isActivated       Boolean  @default(false)
  // status            UserStatus @default(OFFLINE): Store this in Redis

  posts             Post[]
  comments          Comment[]
  likes             Like[]
  reactions         ReactionUser[]

  sentRequests      Friendship[]  @relation(name: "SentRequests")
  receivedRequests  Friendship[]  @relation(name: "ReceivedRequests")

  ownedServers      Server[]
  memberships       Member[]

  // The User Interest Vector (e.g., 1536 dimensions if using standard embeddings)
  // This updates dynamically as they like/comment on posts
  interestVector    Unsupported("vector(384)")?

  // Initial selected categories/topics from onboarding
  // Used as fallback when contentVector is unavailable
  selectedCategories String[] @default([])

  // Community Detection mapping
  communityId       String?
  community         Community?  @relation(fields: [communityId], references: [id])
}

// Graph-based community clusters (e.g., "Tech Bros", "K-Pop Fans")
// Generated weekly by the Python ML Service using the Louvain algorithm
model Community {
  id           String   @id @default(uuid())
  name         String?  // Optional: AI can auto-generate a name based on the cluster's posts
  clusterId    Int      @unique // The ID generated by the ML algorithm
  users        User[]
  
  // What does this community care about?
  themeVector  Unsupported("vector(384)")? 
}

model Friendship {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  status       FriendshipStatus @default(PENDING)

  requester    User     @relation(name: "SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId  String

  receiver     User     @relation(name: "ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId   String

  @@unique([requesterId, receiverId]) // Prevent duplicate requests
}

model Post {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  
  content    String
  attachments Attachment[]

  comments   Comment[]
  likes      Like[]

  // The AI-generated embedding of the post's text/images
  contentVector    Unsupported("vector(384)")?

  // Explicit AI-Tagged Categories (Zero-Shot Classification)
  categories       Category[]

  status           PostStatus @default(PENDING)
  moderationReason String? // Tells the user why their post was rejected
}

model Category {
  id     String @id @default(uuid())
  name   String @unique // e.g., "Sports", "Music"
  posts  Post[]
}

model Comment {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
 
  parentId   String?
  parent     Comment?  @relation(name: "CommonReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation(name: "CommonReplies")

  content    String
  mediaUrls  String[] @default([])
  likes      Like[]
}

model Like {
  // For Post and Comment
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  post        Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String?
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId   String?
  // Validation: In Like service, handle a Like to not exist for both a Post and a Comment simultaneously
  // Prisma cannot enforce "XOR" in the schema easily

  targetType  TargetLikeType

  @@unique([postId, userId]) // Prevent duplicate likes
  @@unique([commentId, userId])
}

model ReactionGroup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  icon      String
  count     Int      @default(0)

  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  users     ReactionUser[]

  @@unique([messageId, icon])
  @@index([messageId])
}

model ReactionUser {
  id         String @id @default(uuid())
  userId     String
  reactionId String

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction   ReactionGroup @relation(fields: [reactionId], references: [id], onDelete: Cascade)

  @@unique([userId, reactionId])
}

model Server {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  iconUrl   String?
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String

  channels  Channel[]
  members   Member[]
  roles     Role[]
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  type      ChannelType

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String

  messages  Message[]
  attachments Attachment[]
}

model Member {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())
  nickname  String?
  isMuted   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  serverId  String

  roles     Role[]
  messages  Message[]

  @@unique([userId, serverId]) // User can only be in a server once
}

model Role {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  name      String
  color     String
  permissions Int    // Bitmask integer

  server    Server   @relation(fields: [serverId], references: [id],onDelete: Cascade)
  serverId  String

  members   Member[]

  @@unique([name,serverId])
}

model Message {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  content     String?
  attachments Attachment[]
  reactions   ReactionGroup[]
  deleted     Boolean  @default(false)

  replyToId   String?
  replyTo     Message?  @relation("Reply", fields: [replyToId], references: [id])
  replies     Message[] @relation("Reply")

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId   String

  sender      Member   @relation(fields: [memberId], references: [id])
  memberId    String

  @@index([channelId, createdAt])
}

model Attachment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  url       String
  publicId  String
  type      AttachmentType
  filename  String
  mimeType  String
  size      Int
  status AttachmentStatus @default(TEMP)
  // Belongs to a Message (Discord side)
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String?

  // Belongs to a Post (Facebook side)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  @@index([status,createdAt])
}

enum GlobalRole {
  USER
  MODERATOR     // Can delete any public post, ban users globally
  SUPER_ADMIN   // Can do everything, including changing platform settings
}

enum PostStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum TargetLikeType {
  POST
  COMMENT
}

enum ChannelType {
  TEXT
  VOICE
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum AttachmentStatus {
  TEMP 
  USED
}